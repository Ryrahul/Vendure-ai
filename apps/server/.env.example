# Copy to .env and fill in.
APP_ENV=dev
PORT=3000
COOKIE_SECRET=change-me
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# Postgres with pgvector (docker compose up -d postgres_db exposes it on 6543)
DB_HOST=localhost
DB_PORT=6543
DB_NAME=ai_vendure
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# AI — configure one of these (see the plugin README, "Model providers").
# 1) OpenAI: chat, embeddings and web search.
OPENAI_API_KEY=

# 2) Azure OpenAI: chat (primary without OPENAI_API_KEY, otherwise the fallback) and web search;
#    embeddings too when AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME is set.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
# Only if the embedding deployment is on another resource / key:
AZURE_OPENAI_EMBEDDING_RESOURCE_NAME=
AZURE_OPENAI_EMBEDDING_API_KEY=

# 3) Self-hosted / OpenAI-compatible (Ollama, vLLM, LM Studio, DeepSeek, OpenRouter…)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_CHAT_MODEL=qwen3:14b
# LLM_EMBEDDING_MODEL=nomic-embed-text
# LLM_EMBEDDING_DIMENSIONS=768

# Production only: public URL of the asset server
# ASSET_URL_PREFIX=https://my-vendure.com/assets/
