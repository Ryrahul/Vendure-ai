# Copy to .env and fill in.
APP_ENV=dev
PORT=3000
COOKIE_SECRET=change-me
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# Postgres with pgvector (docker compose up -d postgres_db exposes it on 6543)
DB_HOST=localhost
DB_PORT=6543
DB_NAME=ai_vendure
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# AI — at least one chat provider. OpenAI also covers embeddings and web search.
OPENAI_API_KEY=
# Azure OpenAI chat (primary without OPENAI_API_KEY, otherwise the fallback)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Production only: public URL of the asset server
# ASSET_URL_PREFIX=https://my-vendure.com/assets/
