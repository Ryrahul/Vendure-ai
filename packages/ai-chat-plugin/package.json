{
  "name": "@rahul_vendure/ai-chat-plugin",
  "version": "0.5.1",
  "description": "AI-powered shopping assistant plugin for Vendure — LLM chat, vector search, cart management, and order tracking",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "prebuild": "npm run codegen",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "ai",
    "chat",
    "shopping-assistant",
    "openai",
    "llm",
    "vector-search",
    "pgvector",
    "embeddings",
    "ecommerce"
  ],
  "author": "Rahul Yadav",
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryrahul/Vendure-ai.git",
    "directory": "packages/ai-chat-plugin"
  },
  "peerDependencies": {
    "@vendure/core": ">=3.1.0 <4.0.0"
  },
  "dependencies": {
    "@ai-sdk/azure": "^3.0.53",
    "@ai-sdk/openai": "^3.0.0",
    "ai": "^6.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@swc/core": "^1.16.18",
    "@vendure/core": "3.5.4",
    "@vendure/testing": "^3.5.4",
    "pg": "^8.18.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
