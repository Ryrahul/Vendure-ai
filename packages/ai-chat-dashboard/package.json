{
  "name": "@rahul_vendure/ai-chat-dashboard",
  "version": "0.1.0",
  "description": "AI chat assistant widget for the Vendure admin dashboard — adds a floating chat panel to the React-based Vendure 3.x dashboard",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./dashboard": "./src/dashboard/index.tsx"
  },
  "files": [
    "dist",
    "src/dashboard",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "ai",
    "chat",
    "dashboard",
    "admin",
    "admin-ui",
    "react"
  ],
  "author": "Rahul Yadav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ryrahul/Vendure-ai.git",
    "directory": "packages/ai-chat-dashboard"
  },
  "peerDependencies": {
    "@vendure/core": ">=3.0.0",
    "@vendure/dashboard": ">=3.5.0"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vendure/core": "3.5.4",
    "@vendure/dashboard": "3.5.4",
    "react": "^19.2.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.8.0"
  }
}
